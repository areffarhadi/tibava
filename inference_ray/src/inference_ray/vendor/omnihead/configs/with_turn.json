    "turn": {
      "kind": "turn",
      "heads": [
        "turn/turn_head_qwen3asr.pt"
      ],
      "max_sec": 8.0,
      "crop": "last"
    },
    "vad": {
      "kind": "vad",
      "heads": [
        "vad/vad_6head_lr.json"
      ],
      "max_sec": 120.0,
      "crop": "chunks"
    }
  }
